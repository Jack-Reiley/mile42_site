{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mile42.com/schemas/delivery-plan.schema.json",
  "title": "Software delivery plan",
  "type": "object",
  "required": ["schemaVersion", "runId", "deliveryUnits"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "deliveryUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tickets",
          "strategy",
          "branch",
          "base",
          "dependsOn",
          "mergeOrder",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tickets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "strategy": {
            "enum": ["shared-branch", "independent", "stacked"]
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "mergeOrder": {
            "type": "integer",
            "minimum": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
