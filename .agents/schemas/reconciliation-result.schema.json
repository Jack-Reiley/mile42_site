{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mile42.com/schemas/reconciliation-result.schema.json",
  "title": "Ticket reconciliation result",
  "type": "object",
  "required": [
    "schemaVersion",
    "ticket",
    "pullRequest",
    "decision",
    "currentContractPassed",
    "currentTicketDefects",
    "followUpTickets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ticket": {
      "type": "integer",
      "minimum": 1
    },
    "pullRequest": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "RETURN_TO_IMPLEMENTATION",
        "ACCEPT_WITH_FOLLOW_UP",
        "SPLIT_INTO_FOLLOW_UP_TICKETS",
        "BLOCKED_BY_REQUIREMENT_DECISION"
      ]
    },
    "currentContractPassed": {
      "type": "boolean"
    },
    "currentTicketDefects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "followUpTickets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "ACCEPT_WITH_FOLLOW_UP",
              "SPLIT_INTO_FOLLOW_UP_TICKETS"
            ]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "currentContractPassed": {
            "const": true
          },
          "followUpTickets": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "RETURN_TO_IMPLEMENTATION"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "currentTicketDefects": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
