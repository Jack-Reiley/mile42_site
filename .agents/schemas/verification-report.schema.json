{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mile42.com/schemas/verification-report.schema.json",
  "title": "Ticket verification report",
  "type": "object",
  "required": ["schemaVersion", "ticket", "pullRequest", "scenarios", "outcome"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ticket": {
      "type": "integer",
      "minimum": 1
    },
    "pullRequest": {
      "type": "integer",
      "minimum": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SCN-[0-9]{3,}$"
          },
          "status": {
            "enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED"]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "enum": [
        "IMPLEMENTATION_REQUIRED",
        "RECONCILIATION_REQUIRED",
        "BLOCKED"
      ]
    }
  },
  "additionalProperties": false
}
