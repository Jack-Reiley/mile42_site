{
  "name": "mile42-site",
  "private": true,
  "version": "0.1.0",
  "description": "Mile42 website. site/ is the designed site; copy_prototype/ is the copy reference.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm --prefix site run dev",
    "build": "npm --prefix site run build",
    "preview": "npm --prefix site run preview",
    "setup": "npm --prefix site install",
    "tokens:check": "node design/tokens/verify/check.mjs",
    "test:unit": "npm --prefix site run test",
    "copy:parity": "node site/verify/copy-parity.mjs",
    "illustrations:placeholders": "node site/verify/placeholders.mjs",
    "copy": "npm --prefix copy_prototype run dev",
    "copy:setup": "npm --prefix copy_prototype install",
    "copy:build": "npm --prefix copy_prototype run build",
    "copy:preview": "npm --prefix copy_prototype run preview",
    "illustrations:build": "npm --prefix site run illustrations:build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
