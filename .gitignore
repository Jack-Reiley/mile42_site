# Dependencies
node_modules/

# Build output
dist/
.netlify/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp

# Local overrides
*.local

# Agent delivery runtime state
.delivery/

# A global gitignore on some machines excludes .claude/ entirely. Git will not
# descend into an excluded directory, so a bare negation for a file inside it
# has no effect — the directory itself has to be re-included first, then its
# contents re-excluded selectively.
!.claude/
.claude/*
!.claude/commands/
.claude/commands/*.local.md

# Local-only Claude state: machine specific, not shared.
.claude/settings.local.json
.claude/*.state.json
